# FalkorDB Graph Database
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# Tenancy & API Auth
TENANTS=acme,globex
TENANT_KEYS=acme:acme-demo-key,globex:globex-demo-key

# Agent Configuration
AGENT_MODE=mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=medium

# Embedding Configuration
EMBED_PROVIDER=mock
EMBED_DIM=4096
EMBED_MODEL=gemini-embedding-001

# System & Concurrency
CLOCK_NOW=
MAX_INFLIGHT=64
